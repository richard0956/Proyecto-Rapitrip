# Variables de las Edge Functions. Copiar a supabase/functions/.env (Supabase lo carga solo).
# NO poner SUPABASE_URL ni las claves de Supabase aquí: las inyecta el entorno de las funciones.
MAIL_MODE=log
MAIL_FROM=Rapitrip <no-reply@example.com>
CONSOLE_URL=http://127.0.0.1:3001
# Aplicación del repartidor (apps/courier): a ella llega el enlace de la invitación.
COURIER_APP_URL=http://127.0.0.1:3002
OUTBOX_SECRET=cambia-este-valor-por-uno-aleatorio
RESEND_API_KEY=


# Mapas (Mapbox): token para calcular la distancia por calle del envío (función quote-delivery). Sin él se usa la línea recta.
#   Debe poder llamarse desde un servidor: si restringes el token por URL, crea otro (sk. o sin restricción) para aquí.
MAPBOX_TOKEN=

{
  "name": "@rapitrip/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:backend": "playwright test --grep @backend",
    "e2e:comercio": "playwright test tests/comercio.spec.ts",
    "e2e:stripe": "playwright test tests/pagos.spec.ts",
    "e2e:operaciones": "playwright test tests/comercio.spec.ts tests/caja.spec.ts tests/coordinacion.spec.ts tests/admin-operaciones.spec.ts tests/pedido-completo.spec.ts tests/tienda-pedido.spec.ts tests/mapas.spec.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e:front": "playwright test --grep-invert @backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

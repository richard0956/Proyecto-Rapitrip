# ─────────────────────────────────────────────────────────────────────────────
# Rapitrip · guía de variables de entorno
#
# Este archivo NO se carga: es el índice de TODAS las credenciales y variables del proyecto, para saber qué
# poner y dónde. Cada bloque dice a qué archivo real se copia. Los archivos reales están ignorados por git
# (.env, .env.local); nunca subas valores reales al repositorio.
#
# Leyenda:  [PÚBLICO]  se incrusta en el navegador, no es secreto (pero sí cambia entre local y producción)
#           [SECRETO]  nunca va al navegador ni al repositorio
#           [LOCAL]    lo imprime `pnpm db:start` (comando `supabase status`)
#           [TÚ]       lo creas tú en el servicio externo
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════ 1. apps/console/.env.local  y  apps/store/.env.local ═════════════
# Las dos apps necesitan estas cuatro. En producción se cargan en cada proyecto de Vercel.

# [PÚBLICO][LOCAL] URL de la API de Supabase.
#   Local: http://127.0.0.1:54321      Producción: https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [PÚBLICO][LOCAL] Clave anónima (anon key). Local: `supabase status` → "anon key".
#   Producción: Supabase → Project Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [PÚBLICO] URL pública de ESA app (cada app la suya).
#   Consola local: http://127.0.0.1:3001     Tienda local: http://127.0.0.1:3000
#   Producción: https://consola.tudominio.com  /  https://tudominio.com
NEXT_PUBLIC_SITE_URL=

# [PÚBLICO] Zona horaria para mostrar fechas. Rapitrip opera en Nicaragua.
NEXT_PUBLIC_TIMEZONE=America/Managua

# [PÚBLICO][TÚ] Clave del sitio de Cloudflare Turnstile (CAPTCHA). Vacío = sin CAPTCHA.
#   Pruebas locales (siempre pasa): 1x00000000000000000000AA
#   Producción: Cloudflare → Turnstile → crear widget con los dominios de AMBAS apps.
#   Importante: activa el CAPTCHA en las dos puntas a la vez (esta clave y SUPABASE_AUTH_CAPTCHA_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Solo apps/console ──
# [PÚBLICO] Moneda de los precios (código ISO 4217). Por defecto córdobas.
NEXT_PUBLIC_CURRENCY=NIO

# ── Solo apps/store ──
# [PÚBLICO] "true" muestra el botón «Continuar con Google» (requiere el bloque 2).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# [PÚBLICO] Correo de contacto para derechos sobre datos personales (se muestra en Términos y Privacidad).
NEXT_PUBLIC_CONTACT_EMAIL=


# ═════════════ 2. supabase/.env  (lo lee `supabase start`; en producción: panel de Supabase) ═════════════

# [SECRETO][TÚ] Ingreso con Google. Google Cloud Console → APIs y servicios → Credenciales →
#   ID de cliente OAuth (tipo «Aplicación web»).
#   URI de redirección autorizado — local: http://127.0.0.1:54321/auth/v1/callback
#                                  producción: https://<tu-proyecto>.supabase.co/auth/v1/callback
#   Si [auth.external.google] está activado en config.toml, estas dos son OBLIGATORIAS o `supabase start` falla.
#   Producción: Supabase → Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# [SECRETO][TÚ] Clave secreta de Turnstile (la pareja de NEXT_PUBLIC_TURNSTILE_SITE_KEY).
#   Pruebas locales (siempre pasa): 1x0000000000000000000000000000000AA
#   Producción: Supabase → Authentication → Attack Protection → CAPTCHA.
SUPABASE_AUTH_CAPTCHA_SECRET=


# ═════════════ 3. supabase/functions/.env  (Edge Functions; en producción: `supabase secrets set`) ═════════════
# NO pongas SUPABASE_URL ni las claves de Supabase aquí: el entorno de las funciones las inyecta solo.

# "log" imprime los correos en la consola (local); "resend" los envía de verdad (producción).
MAIL_MODE=log
# Remitente de los correos. En producción debe ser un dominio verificado en Resend.
MAIL_FROM=Rapitrip <no-reply@example.com>
# URL de la consola, para los enlaces de los correos (invitaciones). Local: http://127.0.0.1:3001
CONSOLE_URL=http://127.0.0.1:3001
# [SECRETO] Secreto compartido para disparar el envío de la bandeja de correos. Genera uno aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OUTBOX_SECRET=
# [SECRETO][TÚ] Clave de API de Resend (https://resend.com → API Keys). Solo hace falta con MAIL_MODE=resend.
RESEND_API_KEY=


# ═════════════ 4. Pruebas E2E con backend (variables del shell, no van en un archivo) ═════════════
# Las imprime `supabase status -o env`. Solo para tu máquina o el CI; SERVICE_ROLE es SECRETA y nunca va a la app.
#   export SUPABASE_URL=http://127.0.0.1:54321
#   export SUPABASE_ANON_KEY=<anon key>
#   export SUPABASE_SERVICE_ROLE_KEY=<service_role key>
#   pnpm e2e:comercio


# ═════════════ 5. Solo producción: lo que se crea fuera del código ═════════════
#  · Proyecto de Supabase (URL y anon key → bloque 1) y `supabase db push` de las migraciones.
#  · Dos proyectos de Vercel (Root Directory: apps/console y apps/store) con las variables del bloque 1.
#  · Google OAuth (bloque 2), Cloudflare Turnstile (bloques 1 y 2) y Resend con dominio verificado (bloque 3).
#  · Primer superadmin: ver docs/fase-1-puesta-en-marcha.md, sección 1.

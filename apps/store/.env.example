NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Turnstile: vacío = sin CAPTCHA. Clave de pruebas que siempre pasa: 1x00000000000000000000AA

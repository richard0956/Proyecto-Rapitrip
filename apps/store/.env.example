NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Turnstile: vacío = sin CAPTCHA. Clave de pruebas que siempre pasa: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TIMEZONE=
# "true" muestra el botón de Google (requiere las credenciales en supabase/.env)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# Correo de contacto para derechos de datos personales (se muestra en Términos y Privacidad si existe)
NEXT_PUBLIC_CONTACT_EMAIL=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TIMEZONE=
# "true" muestra el botón de Google (requiere las credenciales en supabase/.env)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
